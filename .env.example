# =============================================================================
# NotebookLMC - environment configuration
# =============================================================================
# Copy this file to .env and fill in the secrets.
# Never commit a real .env file.
#
# Variables marked "reserved" are defined in the settings classes but are not
# read by any code path yet.
# =============================================================================

# -----------------------------------------------------------------------------
# Network binding (see docs/security.md)
# -----------------------------------------------------------------------------
# Host address for the port mappings of frontend/api/postgres/redis/qdrant/
# minio in docker-compose.yml. The default 127.0.0.1 makes these services
# reachable from the host only (for example through an SSH tunnel). Only Caddy
# (80/443) is public.
#
# WARNING: do not set this to 0.0.0.0 on a publicly reachable host. That
# exposes the API, database, cache and object store directly, bypassing Caddy.
BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
# Allowed CORS origin of the API. Only relevant when the browser talks to the
# API cross-origin (see docs/deployment.md).
APP_URL=http://localhost:3000
# Reserved.
API_URL=http://localhost:8000

# Leave empty (default): the frontend calls the API through relative,
# same-origin paths such as "/api/notebooks", which Caddy (or the Next.js
# route handler on port 3000) forwards to the API. Set an absolute URL only if
# the API is served from a separate domain; APP_URL must then match the
# frontend origin.
# NEXT_PUBLIC_* is a Next.js build argument, not a runtime variable: rebuild
# the frontend image after changing it (docker compose build frontend).
NEXT_PUBLIC_API_URL=

# Target of the server-side proxy in apps/frontend/app/api/[...path]/route.ts:
# the Next.js server forwards relative "/api/*" requests to this internal URL
# over the Docker network. This is a runtime variable; a container restart is
# enough after changing it.
INTERNAL_API_URL=http://api:8000

# -----------------------------------------------------------------------------
# Langdock (single AI gateway, no direct provider access)
# -----------------------------------------------------------------------------
LANGDOCK_API_KEY=
# Reserved.
LANGDOCK_REGION=eu

# Claude via Langdock (Anthropic-compatible API)
LANGDOCK_ANTHROPIC_BASE_URL=https://api.langdock.com/anthropic/eu/v1
# Example values from one Langdock workspace. Model ids depend on your
# workspace and region, see docs/langdock.md. The code never hardcodes a model
# id, it always reads these variables.
LANGDOCK_PRIMARY_MODEL=claude-sonnet-4-6-default
LANGDOCK_FAST_MODEL=claude-haiku-4-5@20251001

# Anthropic "thinking" parameter for LangdockClient.generate_sonnet(). That
# method is not used by the chat or studio flows, so this flag currently has
# no effect on them (see docs/langdock.md).
LANGDOCK_ENABLE_EXTENDED_THINKING=false

# Reserved: Langdock Agents API, Knowledge API and Usage Export API.
LANGDOCK_AGENT_BASE_URL=https://api.langdock.com/agent/v1
LANGDOCK_USE_AGENTS_FOR_STRUCTURED_TASKS=false
LANGDOCK_KNOWLEDGE_API_ENABLED=false
LANGDOCK_KNOWLEDGE_BASE_URL=https://api.langdock.com/knowledge
LANGDOCK_USAGE_EXPORT_ENABLED=false

# -----------------------------------------------------------------------------
# Embeddings via Langdock (OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER and EMBEDDING_DIMENSIONS are reserved. The vector size
# that is actually used is QDRANT_VECTOR_SIZE below and must match the model.
EMBEDDING_PROVIDER=langdock
EMBEDDING_BASE_URL=https://api.langdock.com/openai/eu/v1
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
EMBEDDING_ENCODING_FORMAT=float

# -----------------------------------------------------------------------------
# Reranking (reserved, not implemented: retrieval uses a score heuristic)
# -----------------------------------------------------------------------------
RERANKER_PROVIDER=langdock_haiku
RERANKER_MODEL=${LANGDOCK_FAST_MODEL}
RERANKER_ENABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=notebook
POSTGRES_USER=notebook
POSTGRES_PASSWORD=notebook

# -----------------------------------------------------------------------------
# Redis (job queue, sessions, rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=notebook_chunks
QDRANT_VECTOR_SIZE=1536

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=notebook-files
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-password
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Worker / queue tuning
# -----------------------------------------------------------------------------
# Reserved: the worker process listens on both queues and does not read these
# two values yet.
WORKER_EMBEDDING_CONCURRENCY=2
WORKER_DEFAULT_CONCURRENCY=2
# Wait times in seconds between retries after an HTTP 429 from Langdock.
LANGDOCK_RETRY_BACKOFF_SECONDS=5,15,30,60

# OCR fallback for scanned PDFs without a text layer: pages are rendered to
# JPEG with pdftoppm and sent to Claude Vision through Langdock. Pages that
# have a text layer are not affected (no extra call).
PDF_OCR_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# Auth: Argon2 password hashing and Redis sessions (see docs/security.md)
# -----------------------------------------------------------------------------
# Demo user created by `make seed`. There is no automatic dev login, the demo
# user signs in through the normal login page.
# Do not use a .local/.test/.invalid/.localhost TLD: the e-mail validation in
# the API rejects these special-use domains.
DEV_DEMO_USER_EMAIL=demo@notebooklmc.dev
DEV_DEMO_USER_NAME="Demo User"
DEV_DEMO_USER_PASSWORD=change-me-in-local-env

# Send the session cookie with the Secure attribute. Must be true when served
# over HTTPS and false for plain http://localhost, otherwise the browser
# discards the cookie and login fails.
SESSION_COOKIE_SECURE=false
# 7 days, sliding (every session check extends the TTL in Redis).
SESSION_TTL_SECONDS=604800
# Empty = host-only cookie (no Domain attribute). Works for localhost and for
# any production domain behind the reverse proxy.
SESSION_COOKIE_DOMAIN=
MIN_PASSWORD_LENGTH=10

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# -----------------------------------------------------------------------------
# RAG pipeline
# -----------------------------------------------------------------------------
# The core flow (embedding, retrieval, answer, citation validation) always
# runs. These two Haiku pre-processing steps are optional.
ENABLE_INTENT_DETECTION=false
ENABLE_QUERY_REWRITE=false

# Diversity cap for the retrieval context: at most this many chunks per source
# are guaranteed by round-robin before the remaining slots are filled by score.
CONTEXT_MAX_CHUNKS_PER_SOURCE=4

# Token budget for the final chat answer (apps/api/app/chat/service.py). On
# stop_reason=max_tokens the call is retried once with twice the budget.
CHAT_ANSWER_MAX_TOKENS=4096
