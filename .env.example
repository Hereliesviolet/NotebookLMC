# =============================================================================
# NotebookLM Clone - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the real secrets.
# NEVER commit a real .env file with secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Netzwerk-Bindung (siehe docs/security.md)
# -----------------------------------------------------------------------------
# Host-Bind-Adresse fuer die Port-Mappings von frontend/api/postgres/redis/
# qdrant/minio in docker-compose.yml. Default 127.0.0.1: diese Services sind
# nur lokal auf dem Host erreichbar (z. B. per SSH-Tunnel), nicht ueber die
# oeffentliche Netzwerkschnittstelle. Nur Caddy (80/443) ist davon unabhaengig
# und bleibt oeffentlich.
#
# SICHERHEITSWARNUNG: NIEMALS auf 0.0.0.0 setzen, wenn dieser Host oeffentlich
# erreichbar ist - das exponiert API/DB/Cache/Storage direkt im Internet ohne
# Auth (siehe Dev-Auth-Hinweis unten) und ohne den Schutz durch Caddy. Nur fuer
# lokale Entwicklung auf einem nicht-oeffentlichen Rechner setzen, falls
# direkter externer Zugriff auf einzelne Services benoetigt wird.
BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Leer lassen (Default): das Frontend ruft die API dann ueber relative,
# same-origin Pfade auf (z. B. "/api/notebooks"), die Caddy ohnehin schon auf
# denselben Origin wie das Frontend routet (siehe infra/caddy/Caddyfile und
# docs/deployment.md). Nur bei einer komplett getrennten API-Domain/Subdomain
# (z. B. "notebook-api.example.de") hier eine absolute URL setzen - dann muss
# APP_URL/CORS in apps/api/app/core/config.py die Frontend-Domain kennen.
# ACHTUNG: NEXT_PUBLIC_* ist ein Next.js-Build-Arg, kein Runtime-Env -
# nach einer Aenderung muss das Frontend-Image neu gebaut werden
# (docker compose build frontend && docker compose up -d frontend).
NEXT_PUBLIC_API_URL=

# Ziel fuer die server-seitigen Next.js-rewrites() in
# apps/frontend/next.config.mjs: der Next.js-Server im Container proxied
# relative "/api/*"-Aufrufe des Browsers (siehe NEXT_PUBLIC_API_URL oben)
# selbst zu dieser internen URL, ueber das Docker-Netz. Default "http://api:8000"
# passt fuer den Normalfall (docker-compose.yml und docker-compose.shared-caddy.yml,
# da "api" in beiden Faellen im "default"-Netzwerk dieses Projekts erreichbar
# bleibt). Dadurch funktioniert die App auch OHNE Caddy direkt ueber Port 3000
# (z. B. lokale Entwicklung/Cursor-Portforwarding) - im Gegensatz zu
# NEXT_PUBLIC_API_URL ist dies ein reines Server-Runtime-Env, ein Image-Rebuild
# ist nach Aenderung NICHT noetig, ein "docker compose up -d frontend" reicht.
INTERNAL_API_URL=http://api:8000

# -----------------------------------------------------------------------------
# Langdock (single AI gateway - no direct provider access)
# -----------------------------------------------------------------------------
LANGDOCK_API_KEY=
LANGDOCK_REGION=eu

# Claude via Langdock (Anthropic-compatible API)
LANGDOCK_ANTHROPIC_BASE_URL=https://api.langdock.com/anthropic/eu/v1
# Beispiel/Default aus dem Langdock-Workspace des Nutzers - bei einem anderen
# Langdock-Workspace/einer anderen Region ggf. abweichend, siehe docs/langdock.md
# zur Ermittlung der für DEIN Workspace gültigen Modell-IDs.
# Never guess or hardcode a model id in code - always read it from this env var.
LANGDOCK_PRIMARY_MODEL=claude-sonnet-4-6-default
# Beispiel/Default aus dem Workspace des Nutzers - siehe docs/langdock.md.
LANGDOCK_FAST_MODEL=claude-haiku-4-5@20251001

# Claude Extended Thinking ("thinking" Parameter der Anthropic Messages API,
# siehe docs/langdock.md). Default false -> Verhalten bleibt unverändert.
LANGDOCK_ENABLE_EXTENDED_THINKING=false

# Optional Langdock Agents API (structured tasks) - disabled by default
LANGDOCK_AGENT_BASE_URL=https://api.langdock.com/agent/v1
LANGDOCK_USE_AGENTS_FOR_STRUCTURED_TASKS=false
# Optional Langdock Knowledge Folder API - not used as primary RAG, disabled by default
LANGDOCK_KNOWLEDGE_API_ENABLED=false
LANGDOCK_KNOWLEDGE_BASE_URL=https://api.langdock.com/knowledge

# Optional Langdock Usage Export API (cost monitoring)
LANGDOCK_USAGE_EXPORT_ENABLED=false

# -----------------------------------------------------------------------------
# Embeddings via Langdock (OpenAI-compatible embedding endpoint)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=langdock
EMBEDDING_BASE_URL=https://api.langdock.com/openai/eu/v1
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
EMBEDDING_ENCODING_FORMAT=float

# -----------------------------------------------------------------------------
# Reranking (MVP: Qdrant score heuristic only, Haiku reranking optional/later)
# -----------------------------------------------------------------------------
RERANKER_PROVIDER=langdock_haiku
RERANKER_MODEL=${LANGDOCK_FAST_MODEL}
RERANKER_ENABLED=false

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=notebook
POSTGRES_USER=notebook
POSTGRES_PASSWORD=notebook

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Qdrant
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=notebook_chunks
QDRANT_VECTOR_SIZE=1536

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=notebook-files
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio-password
MINIO_USE_SSL=false

# -----------------------------------------------------------------------------
# Worker / Queue tuning
# -----------------------------------------------------------------------------
WORKER_EMBEDDING_CONCURRENCY=2
WORKER_DEFAULT_CONCURRENCY=2
LANGDOCK_RETRY_BACKOFF_SECONDS=5,15,30,60

# OCR-Fallback fuer gescannte PDFs ohne Text-Layer: rendert betroffene Seiten
# via pdftoppm zu JPEG und schickt sie an Claude Vision (Langdock). Seiten mit
# vorhandenem Text-Layer sind davon nicht betroffen (kein Extra-Call).
PDF_OCR_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# Auth: Argon2-Passwort-Hashing + Redis-Sessions (siehe docs/security.md)
# -----------------------------------------------------------------------------
# Demo-User, den `make seed` anlegt - Login nur noch ueber den echten
# Login-Screen, es gibt keinen Dev-Auto-Login mehr.
# ACHTUNG: keine .local/.test/.invalid/.localhost-TLD verwenden - Pydantics
# EmailStr (email-validator) lehnt diese "special-use"-TLDs beim Registrieren
# und Login immer ab, der Demo-User waere sonst permanent ausgesperrt.
DEV_DEMO_USER_EMAIL=demo@notebooklmc.dev
DEV_DEMO_USER_NAME="Demo User"
DEV_DEMO_USER_PASSWORD=change-me-in-local-env

# Session-Cookie nur mit `Secure`-Attribut senden, wenn wirklich per HTTPS
# ausgeliefert wird - lokal ueber http://localhost muss dies false sein,
# sonst verwirft der Browser das Cookie und der Login schlaegt fehl.
SESSION_COOKIE_SECURE=false
# 7 Tage, sliding (jede Session-Pruefung verlaengert die TTL in Redis)
SESSION_TTL_SECONDS=604800
# Leer = Cookie bleibt host-scoped (kein "Domain"-Attribut) - sicherer
# Default, funktioniert unveraendert fuer localhost UND jede Produktions-Domain per Reverse-Proxy.
SESSION_COOKIE_DOMAIN=
MIN_PASSWORD_LENGTH=10

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# -----------------------------------------------------------------------------
# RAG pipeline toggles - the core retrieval ->
# answer -> citation flow always runs; these two Haiku pre-processing steps
# are optional.
# -----------------------------------------------------------------------------
ENABLE_INTENT_DETECTION=false
ENABLE_QUERY_REWRITE=false

# Diversitaets-Cap fuer den Retrieval-Kontext: max. Chunks pro Quelle, die per
# Round-Robin garantiert werden, bevor der Rest nach Score aufgefuellt wird.
CONTEXT_MAX_CHUNKS_PER_SOURCE=4

# Token-Budget fuer die finale Sonnet-Chat-Antwort (chat/service.py). Bei
# stop_reason=max_tokens wird einmalig mit dem doppelten Budget retried.
CHAT_ANSWER_MAX_TOKENS=4096
